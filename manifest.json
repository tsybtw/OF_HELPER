{
  "manifest_version": 3,
  "name": "OF HELPER",
  "version": "219",
  "description": "By @yen_ofsfs",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "clipboardWrite",
    "clipboardRead",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "network_interceptor.js",
        "server/crop/images/*",
        "server/files/*",
        "offscreen.html",
        "offscreen.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OF HELPER"
  },
  "content_scripts": [
    {
      "matches": [
        "*://onlyfans.com/*"
      ],
      "js": [
        "content_interceptor.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/ico128.png"
  }
}